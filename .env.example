# Copy to .env and adjust. Compose and the Makefile both read this.

# --- Postgres / PostGIS (canonical store) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sqitch target URI (derived from the above on the homelab; overridable here).
SQITCH_TARGET=db:pg://atlas:atlas@localhost:5432/atlas

# SQLAlchemy/psycopg URL used by Dagster, dbt, FastAPI.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# --- Ingest ---
BUDGET_API=https://budgetmap.treasury.qld.gov.au/api/projects
BP3_API=https://budgetmap.treasury.qld.gov.au/api/bp3projects
REGIONS_API=https://budgetmap.treasury.qld.gov.au/api/regions
RDP_GEOJSON=https://budgetmapprodstorage.s3-ap-southeast-2.amazonaws.com/prod/data/RDP.geojson
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_UA=qld-atlas/0.4 (open data enrichment; contact jake1802@gmail.com)
# Financial year stamped on each ingested package (decision #2: current year only).
PACKAGE_FINANCIAL_YEAR=2024-25
PACKAGE_ID=1

# --- Tiles / object store (homelab) ---
MARTIN_URL=http://localhost:3001
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas-minio-secret
MINIO_BUCKET=atlas-lakehouse

# --- Frontend ---
NEXT_PUBLIC_TILES_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
